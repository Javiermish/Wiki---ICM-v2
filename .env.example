NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen exacto de la app, sin ruta ni barra final. Desarrollo: http://localhost:3000
SITE_URL=
# Solo servidor. Confirma cargas validadas; nunca usar NEXT_PUBLIC_ ni enviar al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado existente, sin r2.dev ni dominio público. Token con acceso solo a este bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opt-in solo para mostrar muestras claramente DEMO en el catálogo. Por defecto: false.
WIKI_ENABLE_DEMO_MATERIALS=false
